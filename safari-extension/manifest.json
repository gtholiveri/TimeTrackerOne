{
    "manifest_version": 3,
    "name": "TT Safari",
    "description": "Sends which page is on screen to your TimeTracker relay.",
    "version": "0.1",
    "background": {
        "scripts": [
            "background.js"
        ]
    },
    "content_scripts": [
        {
            "js": [
                "content.js"
            ],
            "matches": [
                "<all_urls>"
            ],
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "TT Safari"
    },
    "permissions": [
        "storage",
        "alarms"
    ],
    "host_permissions": [
        "<all_urls>"
    ]
}

{
    "manifest_version": 3,
    "name": "TT Safari",
    "description": "Sends which page is on screen to your TimeTracker relay.",
    "icons": {
        "48": "icon-48.png",
        "96": "icon-96.png",
        "128": "icon-128.png",
        "256": "icon-256.png",
        "512": "icon-512.png"
    },
    "version": "0.1",
    "background": {
        "scripts": [
            "background.js"
        ],
        "persistent": false
    },
    "content_scripts": [
        {
            "js": [
                "content.js"
            ],
            "matches": [
                "<all_urls>"
            ],
            "run_at": "document_start"
        }
    ],
    "action": {
        "default_popup": "popup.html",
        "default_title": "TT Safari",
        "default_icon": {
            "48": "icon-48.png",
            "96": "icon-96.png",
            "128": "icon-128.png"
        }
    },
    "permissions": [
        "storage",
        "alarms"
    ],
    "host_permissions": [
        "<all_urls>"
    ]
}

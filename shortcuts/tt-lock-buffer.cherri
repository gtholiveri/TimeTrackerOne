/*
TT Lock Buffer: does a loop that polls Is Locked survive a long lock if it
writes nothing while locked, and does it see the unlock right away?

Every 2 s for about 6 minutes it reads Is Locked, brightness and the current
app, and adds a line to a buffer. Whenever Is Locked reads "No", the buffer is
joined into one text and appended to tt-lockbuf.txt in iCloud Drive >
Shortcuts. So nothing is written while locked, and every tick ends up in the
file, locked ones included. A tick whose Is Locked read failed shows up as
"locked=" with nothing after it.
    tt|src=ios|kind=poll|ctx=lock-buffer|run=<id>|ts=<time>|tick=<n>|locked=<Yes/No>|cur=<app>|bright=<0..1>
*/

#define name TT Lock Buffer
#define color red

#include 'actions/calendar'
#include 'tt-actions.cherri'

const run = randomNumber(100000, 999999)
@buffer = []

repeat i for 150 {
    const ts = formatDate(CurrentDate, "Custom", "yyyy-MM-dd HH:mm:ss.SSSXXX")
    const locked = deviceDetail("Device Is Locked")
    const bright = deviceDetail("Current Brightness")
    const cur = currentApp("Current")
    @buffer += "tt|src=ios|kind=poll|ctx=lock-buffer|run={run}|ts={ts}|tick={i}|locked={locked}|cur={cur}|bright={bright}"
    @lockedText = "{locked}"
    if @lockedText == "No" {
        // One text, not a list: a list makes Append to Text File ask "Choose an item".
        const lines = joinText(@buffer, "\n")
        const written1 = appendLine("tt-lockbuf.txt", "{lines}")
        @buffer = []
    }
    wait(2)
}

const end = formatDate(CurrentDate, "Custom", "yyyy-MM-dd HH:mm:ss.SSSXXX")
@buffer += "tt|src=ios|kind=poll.end|ctx=lock-buffer|run={run}|ts={end}"
const rest = joinText(@buffer, "\n")
const written2 = appendLine("tt-lockbuf.txt", "{rest}")

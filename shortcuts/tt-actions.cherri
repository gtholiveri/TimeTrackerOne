/*
Action definitions shared by the TT test shortcuts. Cherri's built-in versions
either lack these settings (Device Is Locked, Make New Line) or don't exist
(Get Current App). Identifiers and settings match what the Shortcuts app
writes, taken from TT Poll via its iCloud link.
*/

// Get Current App. scope: "Current" or "Visible".
action 'getcurrentapp' currentApp(text scope: 'WFVisibleAppScope')

// Get Device Details, e.g. "Device Is Locked" or "Current Brightness".
action 'getdevicedetails' deviceDetail(text detail: 'WFDeviceDetail')

// Append to Text File in the Shortcuts folder (iCloud Drive > Shortcuts). Only
// the retired tests in test-harness/shortcuts use it; the tracker writes no files.
// with Make New Line on.
action 'file.append' appendLine(text filePath: 'WFFilePath', text line: 'WFInput') {
    "WFAppendFileWriteMode": "Append",
    "WFAppendOnNewLine": true
}

// TimeTracker app action (ios/App/TTIntents.swift). They record lines in the
// app's queue and upload them when there's network, and never fail, so an
// automation never shows an error banner. Parameter names here must match the
// Swift ones. Log TT Lines answers "stop" when a newer TT Watch has taken
// over, else "ok". Cherri wraps the nested AppIntentDescriptor in a Shortcuts
// dictionary value; fix-app-intents.py unwraps it before signing.
action 'com.gtholiveri.timetracker.LogLinesIntent' logLines(text lines: 'lines', text device: 'device', text relay: 'relay'): text {
    "AppIntentDescriptor": {
        "AppIntentIdentifier": "LogLinesIntent",
        "BundleIdentifier": "com.gtholiveri.timetracker",
        "Name": "TimeTracker",
        "TeamIdentifier": "3SC4668U86"
    }
}

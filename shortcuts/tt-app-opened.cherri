/*
TT App Opened: run by the "App is opened" personal automation (all apps, Run Immediately).
Appends one line to tt-events-<date>.txt in iCloud Drive > Shortcuts, then
runs TT Sync to upload it:
    tt|src=ios|kind=open|dev=<device>|ts=<time>|input=<the app the automation passed>|cur=<Get Current App>
The relay (server/) fuses these with TT Watch's lines.
*/

#define name TT App Opened
#define color green

#include 'actions/calendar'
#include 'actions/shortcuts'
#include 'tt-actions.cherri'

const ts = formatDate(CurrentDate, "Custom", "yyyy-MM-dd HH:mm:ss.SSSXXX")
const day = formatDate(CurrentDate, "Custom", "yyyy-MM-dd")
const dev = deviceDetail("Device Name")
const cur = currentApp("Current")
const written1 = appendLine("tt-events-{day}.txt", "tt|src=ios|kind=open|dev={dev}|ts={ts}|input={ShortcutInput}|cur={cur}")
// The name iOS gives TT Sync on import, from its file name TT-Sync.shortcut.
const synced = run("TT-Sync", written1)

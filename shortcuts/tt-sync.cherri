/*
TT Sync: gives the TimeTracker app the relay URL and this phone's name, then
uploads anything the app still has queued. Run it once by hand after adding
it; after that the app uploads on its own (every logged event tries an
upload, and failed ones wait in the queue). It never fails.

The relay URL and key are asked once, when you add the shortcut, so they never
appear in the published file.
*/

#define name TT Sync
#define color purple

#question relayURL "Your relay's ingest URL with its key: https://<your relay>/tt/ingest?key=<TT_KEY>" "https://YOUR-RELAY/tt/ingest?key=YOUR-KEY"

#include 'tt-actions.cherri'

const base = text(relayURL)
const dev = deviceDetail("Device Name")
const result = syncTimeTracker("{dev}", "{base}")
show("{result}")

/*
TT Watch: the lock/app watcher. The TT Lock Buffer recipe from Trial 2, logging
only changes.

Every ~2 s it reads Device Is Locked and the current app. It adds a line when
either changed, plus a heartbeat every 150 ticks (about 6 minutes), so a quiet
stretch can be told apart from a dead watcher. Nothing is written while the
phone is locked (that is what made TT Lock Direct fail): lines wait in memory
and are appended to tt-watch-<date>.txt in iCloud Drive > Shortcuts as soon as
Is Locked reads No.
    tt|src=ios|kind=change|dev=<device>|run=<id>|ts=<time>|tick=<n>|locked=<Yes/No>|cur=<app>
kind is start, change, beat or end. The start line, and each beat taken while
unlocked, also carry battery=<0-100>.

It loops until iOS stops it (100000 ticks would be about 64 hours), so the
last heartbeat in the log shows how long iOS let it run.

After writing the lines from a locked stretch it uploads its file, because
unlocking straight back into the same app fires no automation: without this,
the relay wouldn't hear about the unlock until the next app switch. It does
the upload itself (the same tail-then-full protocol as TT Sync) rather than
running TT Sync: both of the runs that died on 2026-10-21 died at an unlock
where an automation's TT Sync ran within a second of this one's, and none of
the seven unlocks with no automation that close did.

Shortcuts has no try/catch, and a failed request stops the whole loop. So it
only uploads with a Wi-Fi network or at least one bar of signal; offline the
lines stay in the file for the next sync that works. (Wi-Fi without internet
still fails.)
*/

#define name TT Watch
#define color blue

#question relayURL "Your relay's ingest URL with its key, the same one TT Sync uses: https://<your relay>/tt/ingest?key=<TT_INGEST_KEY>" "https://YOUR-RELAY/tt/ingest?key=YOUR-KEY"

#include 'actions/calendar'
#include 'actions/device'
#include 'actions/documents'
#include 'actions/network'
#include 'actions/web'
#include 'tt-actions.cherri'

const base = text(relayURL)
const run = randomNumber(100000, 999999)
const dev = deviceDetail("Device Name")
const devq = urlEncode(dev)
const started = formatDate(CurrentDate, "Custom", "yyyy-MM-dd HH:mm:ss.SSSXXX")
const battery0 = getBatteryLevel()
@buffer = []
@buffer += "tt|src=ios|kind=start|dev={dev}|run={run}|ts={started}|battery={battery0}"
@pending = 1
@sinceBeat = 0
@lastState = "start"
@sawLocked = 0

repeat i for 100000 {
    const ts = formatDate(CurrentDate, "Custom", "yyyy-MM-dd HH:mm:ss.SSSXXX")
    const locked = deviceDetail("Device Is Locked")
    const cur = currentApp("Current")
    @lockedText = "{locked}"
    @state = "{locked}|{cur}"
    @sinceBeat += 1
    if @lockedText == "Yes" {
        @sawLocked = 1
    }

    if @state != @lastState {
        @buffer += "tt|src=ios|kind=change|dev={dev}|run={run}|ts={ts}|tick={i}|locked={locked}|cur={cur}"
        @pending += 1
        @lastState = @state
    }
    if @sinceBeat >= 150 {
        // Battery only while unlocked: nothing extra is read while locked.
        @battery = ""
        if @lockedText == "No" {
            const level = getBatteryLevel()
            @battery = "{level}"
        }
        @buffer += "tt|src=ios|kind=beat|dev={dev}|run={run}|ts={ts}|tick={i}|locked={locked}|cur={cur}|battery={@battery}"
        @pending += 1
        @sinceBeat = 0
    }
    if @lockedText == "No" {
        if @pending > 0 {
            // One text, not a list: a list makes Append to Text File ask "Choose an item".
            const lines = joinText(@buffer, "\n")
            const day = formatDate(CurrentDate, "Custom", "yyyy-MM-dd")
            const written1 = appendLine("tt-watch-{day}.txt", "{lines}")
            @buffer = []
            @pending = 0
            if @sawLocked == 1 {
                @sawLocked = 0
                // The offline guard: no Wi-Fi network and no signal, no request.
                // Network details come back untyped; Cherri compares only numbers with >.
                const wifi = getWifiDetail("Network Name")
                @wifiName = "{wifi}"
                const channelDetail = getWifiDetail("Channel Number")
                const channel = getNumbers(channelDetail)
                const barsDetail = getCellularDetail("Number of Signal Bars")
                const bars = getNumbers(barsDetail)
                if @wifiName || channel > 0 || bars > 0 {
                    const name = "tt-watch-{day}.txt"
                    const file = getFile("{name}", nil, false)
                    const fileLines = splitText(file, "\n")
                    const n = count(fileLines)
                    @body = "{file}"
                    if n > 20 {
                        const first = n - 19
                        const tail = getListItems(fileLines, first, n)
                        @body = joinText(tail, "\n")
                    }
                    const reply = fileRequest("{base}&file={name}&lines={n}&mode=tail&dev={devq}", "POST", @body)
                    @replyText = "{reply}"
                    if @replyText contains "full" {
                        const whole = fileRequest("{base}&file={name}&lines={n}&mode=full&dev={devq}", "POST", file)
                    }
                }
            }
        }
    }
    wait(2)
}

const ended = formatDate(CurrentDate, "Custom", "yyyy-MM-dd HH:mm:ss.SSSXXX")
@buffer += "tt|src=ios|kind=end|dev={dev}|run={run}|ts={ended}"
const rest = joinText(@buffer, "\n")
const endDay = formatDate(CurrentDate, "Custom", "yyyy-MM-dd")
const written2 = appendLine("tt-watch-{endDay}.txt", "{rest}")

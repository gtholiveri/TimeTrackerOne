/*
TT App Closed: run by the "App is closed" personal automation (all apps, Run Immediately).
Hands the event to the TimeTracker app, which queues it and uploads it when
there's network. It never fails, so it never shows an error banner offline.
    tt|src=ios|kind=close|dev=<device>|ts=<time>|input=<the app the automation passed>|cur=<Get Current App>
The relay (server/) fuses these with TT Watch's lines.
*/

#define name TT App Closed
#define color orange

#include 'tt-actions.cherri'

const dev = deviceDetail("Device Name")
const cur = currentApp("Current")
const logged = logAppEvent("close", "{ShortcutInput}", "{cur}", "{dev}")
